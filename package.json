{
  "name": "@magrana/ui",
  "version": "0.1.0",
  "description": "Librería de componentes compartidos del ecosistema Magrana Edu",
  "author": "Magrana Edu Team",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./tokens": "./src/tokens/index.css",
    "./style.css": "./src/tokens/index.css"
  },
  "files": [
    "dist",
    "src/tokens"
  ],
  "scripts": {
    "prepare": "vite build",
    "build": "vite build && tsc --emitDeclarationOnly --declarationDir dist",
    "dev": "vite build --watch"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "react-zoom-pan-pinch": "^4.0.3"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.0",
    "vite-plugin-dts": "^4.0.0"
  }
}
